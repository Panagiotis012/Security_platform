{
  "name": "@zerotrust/gateway",
  "version": "1.0.0",
  "description": "Zero Trust Gateway - Edge/Gateway Plane for enterprise security platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npm --prefix ../shared run build && ts-node src/index.ts",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.1.5",
    "hpp": "^0.2.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "uuid": "^9.0.0",
    "zod": "^3.22.4",
    "winston": "^3.11.0",
    "jsonwebtoken": "^9.0.2",
    "jose": "^5.2.0",
    "http-proxy-middleware": "^2.0.6",
    "ioredis": "^5.3.2",
    "@zerotrust/shared": "file:../shared"
  },
  "devDependencies": {
    "typescript": "5.5.4",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/hpp": "^0.2.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.6",
    "@types/uuid": "^9.0.7",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "ts-node": "^10.9.2",
    "eslint": "^10.0.2",
    "@typescript-eslint/parser": "^6.18.0",
    "@typescript-eslint/eslint-plugin": "^6.18.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "private": true
}
