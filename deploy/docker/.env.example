# ============================================================================
# Security Platform — Environment Variables
# Copy to .env and fill in your values. NEVER commit .env to git.
# ============================================================================

# OIDC Configuration (required for Identity Plane)
OIDC_GOOGLE_ENABLED=false
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=

OIDC_MICROSOFT_ENABLED=false
OIDC_MICROSOFT_CLIENT_ID=
OIDC_MICROSOFT_CLIENT_SECRET=

OIDC_KEYCLOAK_ENABLED=false
OIDC_KEYCLOAK_ISSUER=
OIDC_KEYCLOAK_CLIENT_ID=
OIDC_KEYCLOAK_CLIENT_SECRET=

# Identity token issuer/audience (must match the Gateway JWT validation config)
TOKEN_ISSUER=https://identity.zerotrust.local
TOKEN_AUDIENCE=https://api.zerotrust.local
# Token algorithm for access/workload JWTs (RS256 or ES256).
TOKEN_ALGORITHM=ES256

# Dev-only helper: mint tokens for local testing without external OIDC.
# Disable this in real deployments.
DEV_TOKEN_ISSUER_ENABLED=false
DEV_TOKEN_ISSUER_SECRET=
# Break-glass override. Keep false unless you explicitly need dev token issuance
# while NODE_ENV=production in a tightly controlled test environment.
ALLOW_DEV_TOKEN_ISSUER_IN_PRODUCTION=false

# Host UID/GID (used by Compose for least-privilege file access in local dev).
# `npm run generate:env` will set these automatically.
HOST_UID=
HOST_GID=

# Public edge (Caddy + ACME) for `docker-compose.public.yml`.
# Required only if you deploy the stack to the public internet with a real domain.
PUBLIC_DOMAIN=
ACME_EMAIL=

# CSRF secret (generate with: `npm run generate:env` or `openssl rand -hex 32`)
CSRF_SECRET=

# PDP admin secret (generate with: `npm run generate:env` or `openssl rand -hex 32`)
PDP_ADMIN_JWT_SECRET=

# Internal gateway->plane authentication secret (generate with: `npm run generate:env` or `openssl rand -hex 32`)
INTERNAL_SHARED_SECRET=
# Internal auth hardening: nonce-bound signatures + replay detection
INTERNAL_AUTH_REQUIRE_NONCE=true
INTERNAL_AUTH_REQUIRE_CALLER=true
INTERNAL_AUTH_REQUIRE_KEY_ID=true
INTERNAL_AUTH_REPLAY_PROTECTION_ENABLED=true
INTERNAL_AUTH_REPLAY_CACHE_MAX_ENTRIES=50000
INTERNAL_AUTH_REPLAY_STORE=redis
INTERNAL_AUTH_REPLAY_REDIS_REQUIRED=true
INTERNAL_AUTH_REPLAY_REDIS_PREFIX=zt:internal-auth:replay:
INTERNAL_CONTROL_PLANE_ENABLED=false
INTERNAL_CONTROL_PLANE_REQUIRE_API_KEY_FOR_MUTATIONS=false
INTERNAL_CONTROL_PLANE_CALLER_ROLES_JSON={}
INTERNAL_CONTROL_PLANE_API_KEYS_JSON=[]
INTERNAL_CONTROL_PLANE_API_KEY_ID_HEADER=x-internal-api-key-id
INTERNAL_CONTROL_PLANE_API_KEY_SECRET_HEADER=x-internal-api-key
# Optional; defaults to INTERNAL_SHARED_SECRET / abuse-intel signing secret / challenge secret.
SECURITY_CONTROLS_AUDIT_SECRET=
SECURITY_CONTROLS_HISTORY_MAX_ENTRIES=10000
SECURITY_CONTROLS_HISTORY_STORE=redis
SECURITY_CONTROLS_HISTORY_REDIS_REQUIRED=true
SECURITY_CONTROLS_HISTORY_REDIS_PREFIX=zt:gateway:security-controls-audit:
SECURITY_CONTROLS_HISTORY_BUNDLE_SOURCE_ID=gateway-edge
SECURITY_CONTROLS_HISTORY_BUNDLE_EXPORT_MAX_ENTRIES=1000
SECURITY_CONTROLS_HISTORY_BUNDLE_DEFAULT_TTL_SECONDS=900
SECURITY_CONTROLS_HISTORY_BUNDLE_SIGN_EXPORTS=true
SECURITY_CONTROLS_HISTORY_BUNDLE_REQUIRE_SIGNED_IMPORTS=true
SECURITY_CONTROLS_HISTORY_BUNDLE_SIGNING_KEY_ID=gateway-controls-v1
# Optional; defaults to SECURITY_CONTROLS_AUDIT_SECRET when empty.
SECURITY_CONTROLS_HISTORY_BUNDLE_SIGNING_SECRET=
SECURITY_CONTROLS_HISTORY_BUNDLE_ALLOWED_SOURCES=gateway-edge
SECURITY_CONTROLS_HISTORY_BUNDLE_ALLOWED_KEY_IDS=gateway-controls-v1
SECURITY_CONTROLS_HISTORY_BUNDLE_KEYRING=gateway-controls-v1:${SECURITY_CONTROLS_AUDIT_SECRET}
SECURITY_CONTROLS_HISTORY_BUNDLE_REPLAY_PROTECTION_ENABLED=true
SECURITY_CONTROLS_HISTORY_BUNDLE_REPLAY_CACHE_MAX_ENTRIES=50000
SECURITY_CONTROLS_HISTORY_BUNDLE_MAX_SKEW_SECONDS=300

# Edge response cache (route opt-in; defaults to distributed Redis store)
EDGE_CACHE_ENABLED=true
EDGE_CACHE_STORE=redis
EDGE_CACHE_REDIS_REQUIRED=true
EDGE_CACHE_REDIS_PREFIX=zt:gateway:edge-cache:
EDGE_CACHE_DEFAULT_TTL_SECONDS=30
EDGE_CACHE_STALE_WHILE_REVALIDATE_SECONDS=15
EDGE_CACHE_STALE_IF_ERROR_SECONDS=120
EDGE_CACHE_VARY_HEADERS=accept,accept-encoding,accept-language
EDGE_CACHE_INCLUDE_QUERY_STRING=true
EDGE_CACHE_IGNORE_QUERY_PARAMS=_,cacheBust
EDGE_CACHE_CACHE_AUTHENTICATED=false
EDGE_CACHE_MAX_BODY_BYTES=262144
EDGE_CACHE_STATUS_CODES=200
EDGE_CACHE_RESPECT_ORIGIN_CACHE_CONTROL=false
EDGE_CACHE_TAG_HEADER=cache-tag
EDGE_CACHE_MAX_TAGS_PER_ENTRY=64
EDGE_CACHE_MAX_TAG_LENGTH=64
EDGE_CACHE_REQUEST_COALESCING_ENABLED=true
EDGE_CACHE_REQUEST_COALESCING_WAIT_MS=250
EDGE_CACHE_MEMORY_MAX_ENTRIES=50000
EDGE_CACHE_VERSION_BUNDLE_SOURCE_ID=gateway-edge
EDGE_CACHE_VERSION_BUNDLE_EXPORT_MAX_ENTRIES=1000
EDGE_CACHE_VERSION_BUNDLE_DEFAULT_TTL_SECONDS=900
EDGE_CACHE_VERSION_BUNDLE_SIGN_EXPORTS=true
EDGE_CACHE_VERSION_BUNDLE_REQUIRE_SIGNED_IMPORTS=true
EDGE_CACHE_VERSION_BUNDLE_SIGNING_KEY_ID=gateway-edge-cache-v1
# Optional; when empty, use EDGE_CACHE_VERSION_BUNDLE_KEYRING.
EDGE_CACHE_VERSION_BUNDLE_SIGNING_SECRET=
EDGE_CACHE_VERSION_BUNDLE_ALLOWED_SOURCES=gateway-edge
EDGE_CACHE_VERSION_BUNDLE_ALLOWED_KEY_IDS=gateway-edge-cache-v1
EDGE_CACHE_VERSION_BUNDLE_KEYRING=gateway-edge-cache-v1:${INTERNAL_SHARED_SECRET}
EDGE_CACHE_VERSION_BUNDLE_REPLAY_PROTECTION_ENABLED=true
EDGE_CACHE_VERSION_BUNDLE_REPLAY_CACHE_MAX_ENTRIES=50000
EDGE_CACHE_VERSION_BUNDLE_MAX_SKEW_SECONDS=300
EDGE_INVALIDATION_LOG_STORE=redis
EDGE_INVALIDATION_LOG_REDIS_REQUIRED=true
EDGE_INVALIDATION_LOG_REDIS_PREFIX=zt:gateway:edge-invalidation:
EDGE_INVALIDATION_LOG_MAX_ENTRIES=100000
EDGE_INVALIDATION_BUNDLE_SOURCE_ID=gateway-edge
EDGE_INVALIDATION_BUNDLE_EXPORT_MAX_ENTRIES=1000
EDGE_INVALIDATION_BUNDLE_DEFAULT_TTL_SECONDS=900
EDGE_INVALIDATION_BUNDLE_SIGN_EXPORTS=true
EDGE_INVALIDATION_BUNDLE_REQUIRE_SIGNED_IMPORTS=true
EDGE_INVALIDATION_BUNDLE_SIGNING_KEY_ID=gateway-edge-invalidation-v1
# Optional; when empty, use EDGE_INVALIDATION_BUNDLE_KEYRING.
EDGE_INVALIDATION_BUNDLE_SIGNING_SECRET=
EDGE_INVALIDATION_BUNDLE_ALLOWED_SOURCES=gateway-edge
EDGE_INVALIDATION_BUNDLE_ALLOWED_KEY_IDS=gateway-edge-invalidation-v1
EDGE_INVALIDATION_BUNDLE_KEYRING=gateway-edge-invalidation-v1:${INTERNAL_SHARED_SECRET}
EDGE_INVALIDATION_BUNDLE_REPLAY_PROTECTION_ENABLED=true
EDGE_INVALIDATION_BUNDLE_REPLAY_CACHE_MAX_ENTRIES=50000
EDGE_INVALIDATION_BUNDLE_MAX_SKEW_SECONDS=300
INTERNAL_MUTATION_IDEMPOTENCY_ENABLED=true
INTERNAL_MUTATION_IDEMPOTENCY_TTL_SECONDS=900
INTERNAL_MUTATION_IDEMPOTENCY_REPLAY_CACHE_MAX_ENTRIES=50000

# WAF advanced controls
WAF_ENABLED=true
WAF_RISK_SCORE_THRESHOLD=50
WAF_CHALLENGE_DURATION_MS=600000
WAF_MANAGED_RULES_VERSION=v1
WAF_ALLOWED_RULE_VERSIONS=v1
# Optional JSON array of custom rules
WAF_CUSTOM_RULES_JSON=
# Optional JSON array of WAF rate rules
WAF_RATE_RULES_JSON=
# Edge access-control policies (IP/CIDR + geo/ASN)
ACCESS_CONTROL_ENABLED=false
ACCESS_CONTROL_BYPASS_INTERNAL=true
ACCESS_CONTROL_COUNTRY_HEADER=x-geo-country
ACCESS_CONTROL_ASN_HEADER=x-geo-asn
ACCESS_CONTROL_IP_ALLOWLIST=
ACCESS_CONTROL_IP_DENYLIST=
ACCESS_CONTROL_COUNTRY_ALLOWLIST=
ACCESS_CONTROL_COUNTRY_DENYLIST=
ACCESS_CONTROL_ASN_ALLOWLIST=
ACCESS_CONTROL_ASN_DENYLIST=
# Optional JSON object of profile overrides, keyed by profile name
ACCESS_CONTROL_PROFILES_JSON=
# Optional JSON object for upstream pool config by upstream name
UPSTREAM_POOLS_JSON=
# Optional secret used to sign upstream cookie-affinity tokens
UPSTREAM_AFFINITY_COOKIE_SECRET=
# Optional comma-separated list of previous signing secrets accepted for rotation
UPSTREAM_AFFINITY_COOKIE_PREVIOUS_SECRETS=
# Bot management clearance cookie
BOT_MANAGEMENT_CLEARANCE_ENABLED=true
BOT_MANAGEMENT_CLEARANCE_COOKIE_NAME=__zt_bot_clearance
BOT_MANAGEMENT_CLEARANCE_TTL_SECONDS=1800
BOT_MANAGEMENT_CLEARANCE_SECURE=true
BOT_MANAGEMENT_CLEARANCE_HTTP_ONLY=true
BOT_MANAGEMENT_CLEARANCE_SAME_SITE=lax
BOT_MANAGEMENT_CLEARANCE_PATH=/
# Optional; defaults to ADAPTIVE_DEFENSE_CHALLENGE_SECRET / INTERNAL_SHARED_SECRET when empty.
BOT_MANAGEMENT_CLEARANCE_SECRET=
BOT_MANAGEMENT_CLEARANCE_PREVIOUS_SECRETS=

# Adaptive edge defense (abuse scoring -> temporary IP block)
ADAPTIVE_DEFENSE_ENABLED=true
ADAPTIVE_DEFENSE_SCORE_WINDOW_MS=300000
ADAPTIVE_DEFENSE_BLOCK_THRESHOLD=100
ADAPTIVE_DEFENSE_BLOCK_DURATION_MS=1800000
ADAPTIVE_DEFENSE_SCORE_WAF_BLOCK=50
ADAPTIVE_DEFENSE_SCORE_RATE_LIMIT=30
ADAPTIVE_DEFENSE_SCORE_AUTH_FAILURE=10
ADAPTIVE_DEFENSE_SCORE_FORBIDDEN=5
ADAPTIVE_DEFENSE_SCORE_BOT_FINGERPRINT=5
ADAPTIVE_DEFENSE_STORE=redis
ADAPTIVE_DEFENSE_REDIS_REQUIRED=true
ADAPTIVE_DEFENSE_REDIS_PREFIX=zt:gateway:ip-reputation:
ADAPTIVE_DEFENSE_IP_ALLOWLIST=
ADAPTIVE_DEFENSE_CHALLENGE_ENABLED=true
ADAPTIVE_DEFENSE_CHALLENGE_THRESHOLD=60
ADAPTIVE_DEFENSE_CHALLENGE_DURATION_MS=600000
ADAPTIVE_DEFENSE_CHALLENGE_TOKEN_TTL_MS=120000
ADAPTIVE_DEFENSE_CHALLENGE_MAX_INVALID_ATTEMPTS=5
ADAPTIVE_DEFENSE_CHALLENGE_INVALID_ATTEMPT_WINDOW_MS=120000
ADAPTIVE_DEFENSE_CHALLENGE_INVALID_ATTEMPT_BACKOFF_MS=15000
ADAPTIVE_DEFENSE_CHALLENGE_HEADER=x-zt-bot-challenge-token
# Optional; defaults to INTERNAL_SHARED_SECRET when empty.
ADAPTIVE_DEFENSE_CHALLENGE_SECRET=
ADAPTIVE_DEFENSE_CHALLENGE_STORE=redis
ADAPTIVE_DEFENSE_CHALLENGE_REDIS_REQUIRED=true
ADAPTIVE_DEFENSE_CHALLENGE_REDIS_PREFIX=zt:gateway:bot-challenge:
# Optional JSON map for per-route/service profiles, e.g. {"auth":{"blockThreshold":20}}
ADAPTIVE_DEFENSE_PROFILES_JSON=
ADAPTIVE_DEFENSE_ABUSE_INTEL_ENABLED=true
ADAPTIVE_DEFENSE_ABUSE_INTEL_SOURCE_ID=gateway-edge
ADAPTIVE_DEFENSE_ABUSE_INTEL_EXPORT_MAX_ENTRIES=1000
ADAPTIVE_DEFENSE_ABUSE_INTEL_DEFAULT_TTL_SECONDS=900
ADAPTIVE_DEFENSE_ABUSE_INTEL_SIGN_EXPORTS=true
ADAPTIVE_DEFENSE_ABUSE_INTEL_REQUIRE_SIGNED_IMPORTS=true
ADAPTIVE_DEFENSE_ABUSE_INTEL_SIGNING_KEY_ID=gateway-abuse-v1
# Optional; defaults to ADAPTIVE_DEFENSE_CHALLENGE_SECRET / INTERNAL_SHARED_SECRET when empty.
ADAPTIVE_DEFENSE_ABUSE_INTEL_SIGNING_SECRET=
ADAPTIVE_DEFENSE_ABUSE_INTEL_ALLOWED_SOURCES=gateway-edge
ADAPTIVE_DEFENSE_ABUSE_INTEL_ALLOWED_KEY_IDS=gateway-abuse-v1
# key=secret list (comma-separated), supports ":" or "=" delimiter
ADAPTIVE_DEFENSE_ABUSE_INTEL_KEYRING=gateway-abuse-v1:${INTERNAL_SHARED_SECRET}
ADAPTIVE_DEFENSE_ABUSE_INTEL_REPLAY_PROTECTION_ENABLED=true
ADAPTIVE_DEFENSE_ABUSE_INTEL_REPLAY_CACHE_MAX_ENTRIES=50000
ADAPTIVE_DEFENSE_ABUSE_INTEL_MAX_SKEW_SECONDS=300
ADAPTIVE_DEFENSE_ABUSE_INTEL_REPLAY_STORE=redis
ADAPTIVE_DEFENSE_ABUSE_INTEL_REPLAY_REDIS_PREFIX=zt:gateway:abuse-intel:replay:

# Optional regional convergence worker (drift detect + auto-heal from peers)
CONTROL_PLANE_CONVERGENCE_ENABLED=false
CONTROL_PLANE_CONVERGENCE_PEERS=
CONTROL_PLANE_CONVERGENCE_AUTO_HEAL=true
CONTROL_PLANE_CONVERGENCE_INTERVAL_MS=60000
CONTROL_PLANE_CONVERGENCE_EXPORT_LIMIT=1000
# Optional JSON object of additional headers for peer fetches
CONTROL_PLANE_CONVERGENCE_HEADERS_JSON={}
CONTROL_PLANE_CONVERGENCE_POLICY_QUORUM_ENABLED=false
CONTROL_PLANE_CONVERGENCE_POLICY_QUORUM_MIN_PEERS=2
CONTROL_PLANE_CONVERGENCE_AUDIT_ENABLED=true
CONTROL_PLANE_CONVERGENCE_AUDIT_SIGNING_KEY_ID=gateway-convergence-v1
# Optional; defaults to INTERNAL_SHARED_SECRET when empty.
CONTROL_PLANE_CONVERGENCE_AUDIT_SIGNING_SECRET=
CONTROL_PLANE_CONVERGENCE_AUDIT_ACTOR=convergence-worker
CONTROL_PLANE_CONVERGENCE_AUDIT_PATH=/internal/control-plane/convergence/peer
CONTROL_PLANE_CONVERGENCE_AUDIT_PERMISSION_SCOPE=convergence.write
CONTROL_PLANE_AUDIT_STORE=redis
CONTROL_PLANE_AUDIT_REDIS_REQUIRED=true
CONTROL_PLANE_AUDIT_REDIS_PREFIX=zt:gateway:control-plane-audit:
CONTROL_PLANE_AUDIT_MAX_ENTRIES=200000
CONTROL_PLANE_AUDIT_BUNDLE_SOURCE_ID=gateway-edge
CONTROL_PLANE_AUDIT_BUNDLE_EXPORT_MAX_ENTRIES=1000
CONTROL_PLANE_AUDIT_BUNDLE_DEFAULT_TTL_SECONDS=900
CONTROL_PLANE_AUDIT_BUNDLE_SIGN_EXPORTS=true
CONTROL_PLANE_AUDIT_BUNDLE_REQUIRE_SIGNED_IMPORTS=true
CONTROL_PLANE_AUDIT_BUNDLE_SIGNING_KEY_ID=gateway-control-plane-audit-v1
# Optional; when empty, use CONTROL_PLANE_AUDIT_BUNDLE_KEYRING.
CONTROL_PLANE_AUDIT_BUNDLE_SIGNING_SECRET=
CONTROL_PLANE_AUDIT_BUNDLE_ALLOWED_SOURCES=gateway-edge
CONTROL_PLANE_AUDIT_BUNDLE_ALLOWED_KEY_IDS=gateway-control-plane-audit-v1
CONTROL_PLANE_AUDIT_BUNDLE_KEYRING=gateway-control-plane-audit-v1:${INTERNAL_SHARED_SECRET}
CONTROL_PLANE_AUDIT_BUNDLE_REPLAY_PROTECTION_ENABLED=true
CONTROL_PLANE_AUDIT_BUNDLE_REPLAY_CACHE_MAX_ENTRIES=50000
CONTROL_PLANE_AUDIT_BUNDLE_MAX_SKEW_SECONDS=300
UPSTREAM_ROUTING_POLICY_BUNDLE_SOURCE_ID=gateway-edge
UPSTREAM_ROUTING_POLICY_BUNDLE_DEFAULT_TTL_SECONDS=900
UPSTREAM_ROUTING_POLICY_BUNDLE_SIGN_EXPORTS=true
UPSTREAM_ROUTING_POLICY_BUNDLE_REQUIRE_SIGNED_IMPORTS=true
UPSTREAM_ROUTING_POLICY_BUNDLE_SIGNING_KEY_ID=gateway-upstream-routing-v1
# Optional; when empty, use UPSTREAM_ROUTING_POLICY_BUNDLE_KEYRING.
UPSTREAM_ROUTING_POLICY_BUNDLE_SIGNING_SECRET=
UPSTREAM_ROUTING_POLICY_BUNDLE_ALLOWED_SOURCES=gateway-edge
UPSTREAM_ROUTING_POLICY_BUNDLE_ALLOWED_KEY_IDS=gateway-upstream-routing-v1
UPSTREAM_ROUTING_POLICY_BUNDLE_KEYRING=gateway-upstream-routing-v1:${INTERNAL_SHARED_SECRET}
UPSTREAM_ROUTING_POLICY_BUNDLE_REPLAY_PROTECTION_ENABLED=true
UPSTREAM_ROUTING_POLICY_BUNDLE_REPLAY_CACHE_MAX_ENTRIES=50000
UPSTREAM_ROUTING_POLICY_BUNDLE_MAX_SKEW_SECONDS=300
ROUTE_POLICY_BUNDLE_SOURCE_ID=gateway-edge
ROUTE_POLICY_BUNDLE_DEFAULT_TTL_SECONDS=900
ROUTE_POLICY_BUNDLE_SIGN_EXPORTS=true
ROUTE_POLICY_BUNDLE_REQUIRE_SIGNED_IMPORTS=true
ROUTE_POLICY_BUNDLE_SIGNING_KEY_ID=gateway-route-policy-v1
# Optional; when empty, use ROUTE_POLICY_BUNDLE_KEYRING.
ROUTE_POLICY_BUNDLE_SIGNING_SECRET=
ROUTE_POLICY_BUNDLE_ALLOWED_SOURCES=gateway-edge
ROUTE_POLICY_BUNDLE_ALLOWED_KEY_IDS=gateway-route-policy-v1
ROUTE_POLICY_BUNDLE_KEYRING=gateway-route-policy-v1:${INTERNAL_SHARED_SECRET}
ROUTE_POLICY_BUNDLE_REPLAY_PROTECTION_ENABLED=true
ROUTE_POLICY_BUNDLE_REPLAY_CACHE_MAX_ENTRIES=50000
ROUTE_POLICY_BUNDLE_MAX_SKEW_SECONDS=300
ROUTE_CANARY_AUTO_ROLLBACK_ENABLED=false
ROUTE_CANARY_AUTO_ROLLBACK_WINDOW_MS=60000
ROUTE_CANARY_AUTO_ROLLBACK_MIN_REQUESTS=25
ROUTE_CANARY_AUTO_ROLLBACK_ERROR_RATE_THRESHOLD=0.25
ROUTE_CANARY_AUTO_ROLLBACK_LATENCY_THRESHOLD_MS=1500
ROUTE_CANARY_AUTO_ROLLBACK_COOLDOWN_MS=300000
ROUTE_CANARY_METRICS_MAX_ROUTES=2000

# Supply-chain encrypted keystore master key (32 bytes, hex).
# Required when SUPPLY_CHAIN_KEYSTORE_ENABLED=true (default in production docker-compose).
SUPPLY_CHAIN_KEYSTORE_MASTER_KEY=

# Redis password (required; generate with: `npm run generate:env`)
REDIS_PASSWORD=

# Grafana admin password (required; generate with: `npm run generate:env`)
GRAFANA_PASSWORD=

# Alert webhook URL (optional, for Slack/Teams/PagerDuty integration).
# This is used by:
#  - Alertmanager (Prometheus alerts)
#  - Telemetry plane (high/critical detection alerts)
ALERT_WEBHOOK_URL=
# Optional per-severity overrides (Telemetry plane only):
ALERT_CRITICAL_WEBHOOK=
ALERT_HIGH_WEBHOOK=

# Telemetry response hooks (optional tuning; defaults are safe)
# These control automated incident response actions executed by the telemetry plane.
HOOK_REQUEST_TIMEOUT_MS=5000
HOOK_BLOCK_IP=true
HOOK_BLOCK_DURATION=30
HOOK_BLOCK_MAX=1440
HOOK_REVOKE_SESSIONS=true
HOOK_STEP_UP=true
HOOK_STEP_UP_LEVEL=1
HOOK_STEP_UP_DURATION=60
HOOK_THROTTLE=true
HOOK_THROTTLE_PERCENT=25
HOOK_THROTTLE_DURATION=60
HOOK_ROTATE_CREDS=false

# Log level (debug, info, warn, error)
LOG_LEVEL=info
