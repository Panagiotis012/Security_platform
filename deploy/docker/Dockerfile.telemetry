FROM node:20-alpine@sha256:09e2b3d9726018aecf269bd35325f46bf75046a643a66d28360ec71132750ec8 AS builder
WORKDIR /build
COPY package*.json tsconfig.json ./
COPY shared/package.json shared/tsconfig.json ./shared/
COPY telemetry/package.json telemetry/tsconfig.json ./telemetry/
# Reduce flaky npm installs in Docker (often caused by unstable IPv6 in build networks).
ENV NODE_OPTIONS="--dns-result-order=ipv4first" \
    npm_config_audit="false" \
    npm_config_fund="false" \
    npm_config_fetch_retries="5" \
    npm_config_fetch_retry_mintimeout="20000" \
    npm_config_fetch_retry_maxtimeout="120000"
 RUN if [ -f package-lock.json ]; then npm ci --workspace=shared --workspace=telemetry --no-audit --no-fund --prefer-offline; else npm install --workspace=shared --workspace=telemetry --no-audit --no-fund --prefer-offline; fi
COPY shared/ ./shared/
COPY telemetry/ ./telemetry/
RUN npm run build -w shared && npm run build -w telemetry && npm prune --omit=dev --workspaces

FROM node:20-alpine@sha256:09e2b3d9726018aecf269bd35325f46bf75046a643a66d28360ec71132750ec8 AS production
RUN apk add --no-cache dumb-init \
    && addgroup -g 1001 -S appgroup \
    && adduser -u 1001 -S appuser -G appgroup

WORKDIR /app
COPY --from=builder --chown=appuser:appgroup /build/shared/dist ./shared/dist
COPY --from=builder --chown=appuser:appgroup /build/shared/package.json ./shared/
COPY --from=builder --chown=appuser:appgroup /build/telemetry/dist ./telemetry/dist
COPY --from=builder --chown=appuser:appgroup /build/telemetry/package.json ./telemetry/
COPY --from=builder --chown=appuser:appgroup /build/package.json ./
COPY --from=builder --chown=appuser:appgroup /build/node_modules ./node_modules
RUN rm -rf ./node_modules/@zerotrust/shared && \
    mkdir -p ./node_modules/@zerotrust && \
    ln -s /app/shared ./node_modules/@zerotrust/shared

USER appuser
EXPOSE 8183
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "telemetry/dist/src/index.js"]
