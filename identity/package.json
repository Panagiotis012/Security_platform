{
  "name": "@zerotrust/identity",
  "version": "1.0.0",
  "description": "Identity & Authorization Plane for Zero Trust security platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "npm --prefix ../shared run build && ts-node src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "jest --coverage",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.2.2",
    "@zerotrust/shared": "file:../shared",
    "cookie-parser": "^1.4.6",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "jose": "^5.2.4",
    "jsonwebtoken": "^9.0.2",
    "openid-client": "^5.6.4",
    "otplib": "^13.4.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.16",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "5.5.4"
  },
  "engines": {
    "node": ">=18.0.0"
