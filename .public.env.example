# Example settings for scripts/public.sh (LOCAL ONLY).
#
# Copy to: .public.env
#
# NOTE:
# - Do NOT commit .public.env (it can include local file paths / secrets).
# - This file is meant to live on your laptop only.

# VM SSH target (user@host)
DEPLOY_TARGET="ubuntu@158.180.52.90"

# Remote repo directory (default is fine if you used the provided ship/deploy scripts)
