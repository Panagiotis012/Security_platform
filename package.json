{
  "name": "security-platform",
  "version": "1.0.0",
  "description": "Zero Trust Security Platform — secure-by-default with central policies, strong identity, segmentation, provable build/deploy integrity, and telemetry for detection/response",
  "private": true,
  "workspaces": [
    "shared",
    "gateway",
    "identity",
    "policy-engine",
    "telemetry",
    "supply-chain"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:shared": "npm run build -w shared",
    "build:gateway": "npm run build -w gateway",
    "build:identity": "npm run build -w identity",
    "build:policy-engine": "npm run build -w policy-engine",
    "build:telemetry": "npm run build -w telemetry",
    "build:supply-chain": "npm run build -w supply-chain",
    "dev:gateway": "npm run dev -w gateway",
    "dev:identity": "npm run dev -w identity",
    "dev:policy-engine": "npm run dev -w policy-engine",
    "dev:telemetry": "npm run dev -w telemetry",
    "dev:supply-chain": "npm run dev -w supply-chain",
    "test": "npm run test:security && npm run test:integration",
    "test:workspaces": "npm run test --workspaces --if-present -- --passWithNoTests",
    "test:security": "jest --config tests/jest.security.config.js",
    "test:integration": "jest --config tests/jest.integration.config.js",
    "test:e2e:compose": "bash tests/e2e/compose-security-regression.sh",
    "test:e2e:attacks:advanced": "bash tests/e2e/compose-advanced-attacks.sh",
    "test:e2e:soak:compose": "bash tests/e2e/compose-soak.sh",
    "test:e2e:soak:compose:long": "bash scripts/soak-compose-longrun.sh",
    "test:opa": "bash scripts/test-opa.sh",
    "lint": "eslint .",
    "typecheck": "tsc -b tsconfig.typecheck.json",
    "docker:up": "docker compose --env-file deploy/docker/.env -f deploy/docker/docker-compose.yml up -d",
    "docker:down": "docker compose --env-file deploy/docker/.env -f deploy/docker/docker-compose.yml down",
    "docker:build": "docker compose --env-file deploy/docker/.env -f deploy/docker/docker-compose.yml build",
    "docker:public:config": "docker compose --env-file deploy/docker/.env -f deploy/docker/docker-compose.public.yml config -q",
    "docker:public:up": "bash scripts/docker-public-up.sh",
    "docker:public:down": "bash scripts/docker-public-down.sh",
    "public:go-live-check": "bash scripts/public-go-live-check.sh",
    "generate:certs": "bash scripts/generate-certs.sh",
    "generate:env": "node scripts/generate-dev-env.mjs",
    "security:static": "bash scripts/security-static-checks.sh",
    "security:audit": "npm audit --workspaces",
    "release:gate": "bash scripts/release-gate.sh",
    "release:gate:prepare": "bash scripts/release-gate.sh --prepare-dev",
    "release:gate:quick": "bash scripts/release-gate.sh --skip-docker",
    "clean": "rm -rf node_modules */node_modules */dist"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
